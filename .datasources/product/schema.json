
{
  "name": "product",
  "title": "商品",
  "schemas": [
    {
      "name": "name",
      "title": "商品名称",
      "type": "String",
      "required": true
    },
    {
      "name": "description",
      "title": "商品描述",
      "type": "String",
      "required": true
    },
    {
      "name": "origin_price",
      "title": "原价",
      "type": "Number",
      "required": true,
      "description": "商品的原价/售价"
    },
    {
      "name": "rating",
      "title": "评分",
      "type": "Number",
      "required": false,
      "default": 0
    },
    {
      "name": "sales",
      "title": "销量",
      "type": "Number",
      "required": false,
      "default": 0
    },
    {
      "name": "images",
      "title": "商品图片",
      "type": "Array",
      "items": {
        "type": "Image"
      },
      "required": true
    },
    {
      "name": "specifications",
      "title": "商品规格",
      "type": "Array",
      "items": {
        "type": "Object",
        "properties": {
          "name": {
            "type": "String",
            "required": true,
            "description": "规格名称，如：尺寸、颜色、口味等"
          },
          "options": {
            "type": "Array",
            "items": {
              "type": "Object",
              "properties": {
                "label": {
                  "type": "String",
                  "required": true,
                  "description": "规格选项的显示标签"
                },
                "value": {
                  "type": "String",
                  "required": true,
                  "description": "规格选项的唯一值"
                },
                "price": {
                  "type": "Number",
                  "required": true,
                  "description": "该规格选项对应的价格"
                },
                "stock": {
                  "type": "Number",
                  "required": false,
                  "default": 0,
                  "description": "该规格选项的库存数量"
                },
                "image": {
                  "type": "Image",
                  "required": false,
                  "description": "规格选项对应的图片"
                }
              }
            },
            "required": true
          }
        }
      },
      "required": false,
      "description": "商品的规格选项，支持多规格组合"
    },
    {
      "name": "product_details",
      "title": "商品详情",
      "type": "Object",
      "properties": {
        "ingredients": {
          "type": "Array",
          "items": {
            "type": "String"
          },
          "required": false,
          "description": "商品成分/配料表"
        },
        "nutrition": {
          "type": "String",
          "required": false,
          "description": "营养成分信息"
        },
        "storage": {
          "type": "String",
          "required": false,
          "description": "存储方式说明"
        },
        "shelf_life": {
          "type": "String",
          "required": false,
          "description": "保质期信息"
        },
        "instructions": {
          "type": "String",
          "required": false,
          "description": "使用说明/烹饪方法"
        },
        "origin": {
          "type": "String",
          "required": false,
          "description": "产地信息"
        }
      },
      "required": false
    },
    {
      "name": "reviews",
      "title": "用户评价",
      "type": "Array",
      "items": {
        "type": "Object",
        "properties": {
          "user_id": {
            "type": "String",
            "required": true,
            "description": "评价用户的ID"
          },
          "user_name": {
            "type": "String",
            "required": true,
            "description": "用户昵称"
          },
          "avatar": {
            "type": "Image",
            "required": false,
            "description": "用户头像"
          },
          "rating": {
            "type": "Number",
            "required": true,
            "description": "评分（1-5分）"
          },
          "content": {
            "type": "String",
            "required": true,
            "description": "评价内容"
          },
          "specification": {
            "type": "String",
            "required": false,
            "description": "购买时的规格"
          },
          "images": {
            "type": "Array",
            "items": {
              "type": "Image"
            },
            "required": false,
            "description": "评价图片"
          },
          "created_at": {
            "type": "DateTime",
            "format": "timestamp-ms",
            "required": true,
            "description": "评价时间"
          }
        }
      },
      "required": false
    },
    {
      "name": "category_ids",
      "title": "分类ID列表",
      "type": "Array",
      "items": {
        "type": "String"
      },
      "required": true,
      "description": "商品所属的分类ID列表，支持一个商品属于多个分类"
    },
    {
      "name": "is_available",
      "title": "是否上架",
      "type": "Boolean",
      "required": true,
      "default": true,
      "description": "商品是否上架销售"
    },
    {
      "name": "total_stock",
      "title": "总库存",
      "type": "Number",
      "required": false,
      "default": 0,
      "description": "商品总库存数量（当没有规格时使用）"
    }
  ],
  "indexes": [
    {
      "name": "idx_name",
      "keys": ["name"],
      "unique": false
    },
    {
      "name": "idx_origin_price",
      "keys": ["origin_price"],
      "unique": false
    },
    {
      "name": "idx_category_ids",
      "keys": ["category_ids"],
      "unique": false
    },
    {
      "name": "idx_available",
      "keys": ["is_available"],
      "unique": false
    }
  ]
}
  