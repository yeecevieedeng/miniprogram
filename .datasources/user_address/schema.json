
{
  "name": "user_address",
  "title": "用户收货地址",
  "schemas": [
    {
      "name": "user_id",
      "title": "用户ID",
      "type": "String",
      "required": true,
      "description": "关联用户账户的唯一标识"
    },
    {
      "name": "name",
      "title": "收货人姓名",
      "type": "String",
      "required": true,
      "description": "收货人真实姓名，2-20个字符"
    },
    {
      "name": "phone",
      "title": "手机号码",
      "type": "String",
      "required": true,
      "description": "11位中国大陆手机号码",
      "format": "regex",
      "pattern": "^1[3-9]\\d{9}$"
    },
    {
      "name": "province",
      "title": "省份",
      "type": "String",
      "required": true,
      "description": "所在省份"
    },
    {
      "name": "city",
      "title": "城市",
      "type": "String",
      "required": true,
      "description": "所在城市"
    },
    {
      "name": "district",
      "title": "区县",
      "type": "String",
      "required": true,
      "description": "所在区县"
    },
    {
      "name": "address",
      "title": "详细地址",
      "type": "String",
      "required": true,
      "description": "街道门牌号等详细地址信息，5-100个字符"
    },
    {
      "name": "postal_code",
      "title": "邮政编码",
      "type": "String",
      "required": false,
      "description": "6位邮政编码",
      "format": "regex",
      "pattern": "^\\d{6}$"
    },
    {
      "name": "is_default",
      "title": "是否默认地址",
      "type": "Boolean",
      "required": true,
      "default": false,
      "description": "是否为默认收货地址，每个用户只能有一个默认地址"
    },
    {
      "name": "label",
      "title": "地址标签",
      "type": "String",
      "required": false,
      "description": "地址标签，如：家、公司、学校",
      "enum": ["家", "公司", "学校", "其他"]
    }
  ],
  "permissions": {
    "create": "owner",
    "read": "owner",
    "update": "owner",
    "delete": "owner"
  },
  "indexes": [
    {
      "name": "idx_user_id",
      "keys": ["user_id"],
      "unique": false
    },
    {
      "name": "idx_user_default",
      "keys": ["user_id", "is_default"],
      "unique": false
    }
  ]
}
  